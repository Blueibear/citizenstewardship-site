---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/proposal-one/', label: 'Proposal One' },
  { href: '/proposal-two/', label: 'Proposal Two' },
  { href: '/community/', label: 'Community' },
  { href: '/submit/', label: 'Submit an Idea' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/">Citizen Stewardship</a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class={Astro.url.pathname === item.href ? 'active' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
