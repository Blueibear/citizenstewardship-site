---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav class="site-nav container" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-logo">
				<img
					src="/assets/images/citizen-stewardship-social.png"
					alt="Citizen Stewardship"
					width="42"
					height="42"
				/>
			</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/proposal-one">Proposal One</HeaderLink>
			<HeaderLink href="/proposal-two">Proposal Two</HeaderLink>
			<HeaderLink href="/community">Community</HeaderLink>
			<HeaderLink href="/submit">Submit</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>
