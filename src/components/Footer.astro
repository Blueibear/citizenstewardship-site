---
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div>
			<a class="footer-brand" href="/">Citizen Stewardship</a>
			<p>
				A nonpartisan public community for reviewing, improving, and discussing democratic
				renewal in the United States.
			</p>
		</div>
		<nav class="footer-links" aria-label="Footer navigation">
			<a href="/proposal-one">Proposal One</a>
			<a href="/proposal-two">Proposal Two</a>
			<a href="/community">Community</a>
			<a href="/submit">Submit</a>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
			<a href="/privacy">Privacy</a>
			<a href="/terms">Terms</a>
		</nav>
		<div class="footer-connect">
			<h2>Connect</h2>
			<SocialLinks variant="footer" ariaLabel="Footer social links" />
		</div>
		<div class="footer-note">
			<p>Read, question, improve, and discuss.</p>
			<p>&copy; {today.getFullYear()} Citizen Stewardship.</p>
		</div>
	</div>
</footer>
