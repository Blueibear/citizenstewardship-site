---
import PageHero from '../components/PageHero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const contactEmail = 'contact@citizenstewardship.org';
const contactMailto = 'mailto:contact@citizenstewardship.org?subject=Citizen%20Stewardship%20contact';
---

<SiteLayout
	title="Contact"
	description="Contact Citizen Stewardship by public email or through the contact form."
>
	<PageHero
		title="Contact"
		lede="Reach Citizen Stewardship by email or through the contact form."
	>
		<div slot="actions" class="hero-actions">
			<a class="button primary" href={contactMailto}>Email Citizen Stewardship</a>
			<a class="button" href="/submit">Proposal submission guidance</a>
		</div>
	</PageHero>

	<section class="section tight">
		<div class="container content-grid">
			<div class="prose">
				<h2>Public contact email</h2>
				<p>
					The public contact address is <a href={contactMailto}>{contactEmail}</a>.
				</p>
				<p>
					For proposal edits, use the Submit page first so your note includes the proposal,
					section, proposed change, reasoning, risks, and sources.
				</p>
				<div class="button-row">
					<a class="button primary" href={contactMailto}>Send email</a>
					<a class="button" href="/community">Visit community forum</a>
				</div>
			</div>
			<aside class="callout">
				<h3>Connect online</h3>
				<p>
					Follow official Citizen Stewardship updates and public channels. For direct contact,
					use <a href={contactMailto}>{contactEmail}</a> or the form below.
				</p>
				<SocialLinks />
			</aside>
		</div>
	</section>

	<section class="section surface-band">
		<div class="container">
			<div class="contact-panel">
				<div class="section-header compact">
					<h2>Contact form</h2>
					<p>
						Use the form below to send a message, correction, or private note. You can also
						email <a href={contactMailto}>{contactEmail}</a> directly.
					</p>
				</div>

				<!-- Editors: test the Formspree endpoint before relying on this form. -->
				<form class="contact-form" action="https://formspree.io/f/mvzyrpgl" method="POST">
					<div class="form-grid">
						<div class="form-field">
							<label for="name">Name</label>
							<input id="name" name="name" type="text" autocomplete="name" required />
						</div>
						<div class="form-field">
							<label for="email">Email</label>
							<input id="email" name="email" type="email" autocomplete="email" required />
						</div>
					</div>
					<div class="form-field">
						<label for="subject">Subject</label>
						<input id="subject" name="subject" type="text" required />
					</div>
					<div class="form-field">
						<label for="message">Message</label>
						<textarea id="message" name="message" rows="8" required></textarea>
					</div>
					<div class="form-actions">
						<button class="button primary" type="submit">Send message</button>
						<a class="button" href={contactMailto}>Use email instead</a>
					</div>
				</form>
			</div>
		</div>
	</section>
</SiteLayout>
