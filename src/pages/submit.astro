---
import PageHero from '../components/PageHero.astro';
import PillarGrid from '../components/PillarGrid.astro';
import ShareButtons from '../components/ShareButtons.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const publicSubmissionsUrl =
	'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/public-submissions';
const communitySubmissionsUrl =
	'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/approved-submissions';
const siteImprovementsUrl =
	'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/site-improvements';
const generalCivicDiscussionUrl =
	'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/general-civic-discussion';
const privateNoteUrl =
	'mailto:contact@citizenstewardship.org?subject=Citizen%20Stewardship%20proposal%20suggestion';
const shareText =
	'Citizen Stewardship: citizen-created proposals for American democratic renewal, public accountability, and citizens over corporations.';

const alignmentChecklist = [
	'Does it strengthen ordinary citizens over corporations or insiders?',
	'Does it reduce corruption, hidden influence, or money in politics?',
	'Does it protect equal rights and voting rights?',
	'Does it improve public education, civic understanding, or transparency?',
	'Does it make government more accountable and understandable?',
	'Does it respect due process and humane administration?',
	'Does it consider tax fairness, economic stability, or public responsibility?',
	'Does it avoid partisan revenge and focus on durable reform?',
];

const shouldSubmit = [
	'Specific proposed changes to Proposal One or Proposal Two.',
	'Missing reform pillars.',
	'Better wording.',
	'Legal or practical concerns.',
	'Evidence-backed criticism.',
	'Examples from U.S. states, cities, public agencies, courts, schools, or comparable democratic institutions.',
	'Tax reform suggestions.',
	'Public education reform suggestions.',
	'Anti-corruption and campaign-finance reforms.',
	'Ways to strengthen equality and rights protections.',
	'Humane immigration reform suggestions.',
	'Ways to reduce corporate capture.',
];

const shouldNotSubmit = [
	'Partisan slogans with no reform substance.',
	'Attacks on ordinary citizens based on race, religion, gender, sexuality, disability, nationality, or political identity.',
	'Calls for violence.',
	'Doxxing or private personal information.',
	'Conspiracy claims without evidence.',
	'Corporate lobbying language disguised as citizen reform.',
	'Spam, fundraising, or self-promotion.',
	'Proposals that remove rights from one group to benefit another.',
];

---

<SiteLayout
	title="Submit"
	description="Official submission instructions for Citizen Stewardship proposal changes, additions, corrections, and public review focused on U.S. democratic reform."
>
	<PageHero
		title="Submit a Proposal Suggestion"
		lede="Use this page to prepare proposed changes, additions, missing pillars, corrections, or better wording for public review of U.S. democratic reform proposals."
	>
		<div slot="actions" class="hero-actions">
			<a
				class="button primary"
				href={publicSubmissionsUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				Submit through the public discussion board
			</a>
			<a
				class="button"
				href={communitySubmissionsUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				View Community Submissions
			</a>
			<a class="button" href={privateNoteUrl}>Email a private note</a>
		</div>
	</PageHero>

	<section class="share-strip">
		<div class="container">
			<ShareButtons
				label="Share this page"
				shareUrl="https://citizenstewardship.org/submit/"
				shareText={shareText}
			/>
		</div>
	</section>

	<section class="section tight">
		<div class="container content-grid">
			<div class="prose">
				<p class="lead-block">
					Submissions are for improving the proposals, not scoring partisan points. A strong
					submission identifies a specific problem, proposes a concrete improvement, and gives
					readers enough context to evaluate the idea fairly within the American civic and
					legal system.
				</p>
				<p>
					Public discussions and proposal submissions are hosted through GitHub Discussions
					because it provides a transparent, organized public record. You do not need to be a
					coder to participate, but GitHub does require a free account to post.
				</p>

				<h2>Core Pillars</h2>
				<p>
					Submissions do not have to agree with every existing proposal, but they should
					seriously engage with one or more of the project's Core Pillars rather than
					repeating a shorter principles list.
				</p>
				<PillarGrid compact />

				<h2>Submission alignment questions</h2>
				<ul class="check-list">
					{alignmentChecklist.map((item) => <li>{item}</li>)}
				</ul>

				<h2>What should be submitted</h2>
				<ul class="check-list">
					{shouldSubmit.map((item) => <li>{item}</li>)}
				</ul>

				<h2>What should not be submitted</h2>
				<ul class="warning-list">
					{shouldNotSubmit.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<aside class="callout">
				<h3>Before you submit</h3>
				<p>
					Strong submissions identify the affected proposal section, explain the problem, and
					connect the recommended change to at least one Core Pillar.
				</p>
			</aside>
		</div>
	</section>

	<section class="section surface-band">
		<div class="container content-grid">
			<div class="prose">
				<h2>Guided submission form</h2>
				<p>
					Public submissions use a guided GitHub form. The form asks for the basics
					needed to understand and evaluate an idea: a title, which proposal it applies to,
					the problem being addressed, the proposed change, and why the change is
					necessary.
				</p>
				<p>
					Optional fields allow contributors to add immediate benefits, risks, long-term
					impacts, sources, examples, or suggested wording. You do not need to write like a
					lawyer or policy expert. The goal is to make serious ideas easier to understand,
					discuss, and improve.
				</p>
				<p>
					Submissions should still be constructive and connected to Proposal One, Proposal
					Two, or both.
				</p>
			</div>
			<aside class="info-panel">
				<h3>Review process</h3>
				<p>
					Submissions may be reviewed for relevance, seriousness, safety, and basic
					alignment with the project's community rules.
				</p>
				<p>
					Review does not mean endorsement. Listing a submission in the Community
					Submissions area does not mean Citizen Stewardship fully agrees with it.
				</p>
				<p>
					Strong criticism is welcome if it is specific, constructive, and honest.
				</p>
				<p>
					Use
					<a href={siteImprovementsUrl} target="_blank" rel="noopener noreferrer">
						Site Improvements
					</a> for page clarity, accessibility, document links, navigation, or repository
					maintenance. Use
					<a href={generalCivicDiscussionUrl} target="_blank" rel="noopener noreferrer">
						General Civic Discussion
					</a> for related civic
					reform ideas that do not fit the submission format.
				</p>
			</aside>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="submit-actions-panel">
				<div>
					<h2>Ready to share a suggestion?</h2>
					<p>
						Public suggestions should go through GitHub Discussions so the conversation can
						stay organized and visible. Use email only for a private note or a concern that
						should not be posted publicly.
					</p>
				</div>
				<div class="button-row">
					<a
						class="button primary"
						href={publicSubmissionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Submit through the public discussion board
					</a>
					<a
						class="button"
						href={communitySubmissionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						View Community Submissions
					</a>
					<a class="button" href={privateNoteUrl}>Email a private note</a>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
