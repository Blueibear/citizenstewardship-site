---
import PageHero from '../components/PageHero.astro';
import ShareButtons from '../components/ShareButtons.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const discussionCategories = {
	proposalOne:
		'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/proposal-one-discussion',
	proposalTwo:
		'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/proposal-two-discussion',
	publicSubmissions:
		'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/public-submissions',
	approvedSubmissions:
		'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/approved-submissions',
	siteImprovements:
		'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/site-improvements',
	generalCivic:
		'https://github.com/Blueibear/citizenstewardship-site/discussions/categories/general-civic-discussion',
};

const forumSections = [
	{
		title: 'Proposal One Discussion',
		description:
			'Discuss the full democratic renewal proposal, challenge assumptions, and suggest section-specific revisions.',
		href: discussionCategories.proposalOne,
	},
	{
		title: 'Proposal Two Discussion',
		description:
			'Review the feasible reform package, identify practical barriers, and propose stronger implementation paths.',
		href: discussionCategories.proposalTwo,
	},
	{
		title: 'Public Submissions',
		description:
			'Post proposed additions, corrections, missing pillars, or evidence-backed criticism for public review.',
		href: discussionCategories.publicSubmissions,
	},
	{
		title: 'Approved Submissions',
		description:
			'Read submissions that have been reviewed for seriousness, relevance, nonpartisanship, and basic factual grounding.',
		href: discussionCategories.approvedSubmissions,
	},
	{
		title: 'Site Improvements',
		description:
			'Suggest improvements to page clarity, accessibility, document links, wording, navigation, or repository maintenance.',
		href: discussionCategories.siteImprovements,
	},
	{
		title: 'General Civic Discussion',
		description:
			'Discuss civic reform ideas that relate to the project but do not fit one proposal or submission category.',
		href: discussionCategories.generalCivic,
	},
];

const shareText =
	'Citizen Stewardship: citizen-created proposals for American democratic renewal, public accountability, and citizens over corporations.';
---

<SiteLayout
	title="Community"
	description="Public forum hub for discussing Citizen Stewardship proposals, submissions, and site improvements for American democratic renewal."
>
	<PageHero
		title="Public Forum Hub"
		lede="Discuss the proposals, suggest changes, challenge assumptions, and read public submissions in a serious civic forum focused on democratic renewal in the United States."
	>
		<div slot="actions" class="hero-actions">
			<a
				class="button primary"
				href={discussionCategories.generalCivic}
				target="_blank"
				rel="noopener noreferrer"
			>
				Open general discussion
			</a>
			<a
				class="button"
				href={discussionCategories.approvedSubmissions}
				target="_blank"
				rel="noopener noreferrer"
			>
				Approved submissions
			</a>
		</div>
	</PageHero>

	<section class="share-strip">
		<div class="container">
			<ShareButtons
				label="Share this page"
				shareUrl="https://citizenstewardship.org/community/"
				shareText={shareText}
			/>
		</div>
	</section>

	<section class="section tight">
		<div class="container content-grid">
			<div class="prose">
				<h2>How this forum should work</h2>
				<p>
					This discussion space is intended to be nonpartisan, evidence-aware,
					rights-respecting, and focused on improving the proposals. Readers should be able
					to compare ideas, pressure-test claims, propose better wording, and identify U.S.
					legal or practical limits without being pushed into party loyalty.
				</p>
				<p>
					Disagreement is welcome. Strong criticism is useful when it is specific,
					constructive, and honest.
				</p>
				<div class="social-inline">
					<h2>Broader updates</h2>
					<p>
						Public discussion happens through GitHub Discussions. Broader updates may also
						appear on Substack and the official social channels.
					</p>
					<SocialLinks />
				</div>
			</div>
			<aside class="callout">
				<h3>Not welcome</h3>
				<ul class="quiet-list">
					<li>Bad-faith partisan trolling.</li>
					<li>Personal attacks, harassment, threats, or doxxing.</li>
					<li>Racism, religious bigotry, or anti-LGBTQ attacks.</li>
					<li>Conspiracy spam or evidence-free claims.</li>
					<li>Corporate astroturfing disguised as citizen input.</li>
				</ul>
			</aside>
		</div>
	</section>

	<section class="section surface-band">
		<div class="container">
			<div class="section-header">
				<h2>Forum sections</h2>
				<p>
					These links point directly to the public GitHub Discussions categories for each
					proposal, submission path, and site improvement topic. GitHub Discussions remains
					the public review forum for proposal work.
				</p>
			</div>
			<div class="forum-grid">
				{
					forumSections.map((section) => (
						<a
							class="forum-card"
							href={section.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="meta-line">GitHub Discussions</span>
							<h3>{section.title}</h3>
							<p>{section.description}</p>
							<span class="text-link">Open discussion</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section id="approved-public-submissions" class="section">
		<div class="container content-grid">
			<div class="prose">
				<h2>Approved Public Submissions</h2>
				<p>
					Approved submissions are reform ideas or proposed additions that have been
					reviewed for seriousness, relevance, nonpartisanship, and basic factual grounding.
					Approval does not mean full endorsement. It means the idea is worth public
					review.
				</p>
				<p>
					This area is intentionally structured so manually maintained approved submission
					cards can replace this summary when submissions are ready to publish.
				</p>
			</div>
			<aside class="approved-placeholder">
				<h3>No approved submissions have been published yet.</h3>
				<p>
					Use the Submit page to prepare a proposal suggestion for public review through
					GitHub Discussions.
				</p>
				<a
					class="button primary"
					href={discussionCategories.approvedSubmissions}
					target="_blank"
					rel="noopener noreferrer"
				>
					View Approved Submissions
				</a>
				<a class="button" href="/submit">Prepare a submission</a>
			</aside>
		</div>
	</section>
</SiteLayout>
