---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page Not Found" description="The requested Citizen Stewardship page could not be found.">
	<section class="section">
		<div class="container not-found-panel">
			<p class="meta-line">404</p>
			<h1>Page not found</h1>
			<p class="content-lede">
				The page you requested is not part of the current static Citizen Stewardship site.
			</p>
			<div class="button-row">
				<a class="button primary" href="/">Return home</a>
				<a class="button" href="/proposal-one">Read Proposal One</a>
				<a class="button" href="/proposal-two">Read Proposal Two</a>
			</div>
		</div>
	</section>
</SiteLayout>
